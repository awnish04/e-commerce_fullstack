# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Database (NeonDB - PostgreSQL)
# Get these from https://console.neon.tech
# Images are stored as base64 in the database (no external service needed)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DIRECT_URL=postgresql://user:password@host/database?sslmode=require

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Store API URL (points to this app's own API)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/<your-store-id>
